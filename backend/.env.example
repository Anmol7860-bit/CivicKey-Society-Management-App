NODE_ENV=development
PORT=4000

# Postgres connection. User defaults to your OS user when omitted.
DATABASE_URL=postgres://localhost:5432/civickey

# Access-token signing secret: at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-value
JWT_ISSUER=civickey-api
JWT_AUDIENCE=civickey-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# bcrypt work factor for password hashing (12 recommended)
BCRYPT_COST=12

# Keyed into the hash of a government-ID number: at least 32 random characters.
# Leave unset to refuse full ID numbers and keep only the type and last 4 digits.
# ID_HASH_PEPPER=change-me-to-a-long-random-secret-value

# Frontend origin allowed to call the API with cookies
CORS_ORIGIN=http://localhost:5173

# Set to the number of proxies in front of the API in production (e.g. 1)
TRUST_PROXY=0

# Failed login attempts allowed per phone/email + IP in the window
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# 'local' (self-hosted) or 'cloud'. The encrypted backup export exists only in local
# mode; in cloud mode its endpoints answer 404 and nothing runs pg_dump.
DEPLOYMENT_MODE=local

# 32 bytes, hex or base64, for the AES-256-GCM backup archive. Unset means no backups.
# Keep it somewhere other than the backups: without it an archive cannot be read.
# BACKUP_ENCRYPTION_KEY=change-me
# BACKUP_DIR=/var/lib/civickey/backups
# PG_DUMP_PATH=/usr/local/bin/pg_dump

# Razorpay hosted checkout. Test credentials during development; live credentials belong
# in the deployment's secrets. With the key pair unset, online payment answers 503 and
# only cash settlement works. Without the webhook secret nothing can settle online at all:
# a webhook is trusted only because its HMAC-SHA256 signature over the raw body matches.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=change-me
# RAZORPAY_WEBHOOK_SECRET=change-me

# Where uploaded photographs are written. Nothing serves this directory: images come
# back only through GET /api/v1/files/:id, for a session in the same society.
# FILE_STORAGE_DIR=/var/lib/civickey/uploads
