NODE_ENV=development
PORT=4000

# Postgres connection. User defaults to your OS user when omitted.
DATABASE_URL=postgres://localhost:5432/civickey

# Access-token signing secret: at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-value
JWT_ISSUER=civickey-api
JWT_AUDIENCE=civickey-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# bcrypt work factor for password hashing (12 recommended)
BCRYPT_COST=12

# Keyed into the hash of a government-ID number: at least 32 random characters.
# Leave unset to refuse full ID numbers and keep only the type and last 4 digits.
# ID_HASH_PEPPER=change-me-to-a-long-random-secret-value

# Frontend origin allowed to call the API with cookies
CORS_ORIGIN=http://localhost:5173

# Set to the number of proxies in front of the API in production (e.g. 1)
TRUST_PROXY=0

# Failed login attempts allowed per phone/email + IP in the window
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
